                  Status: <strong className="text-amber-400">{parsedData.status}</strong>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Tab 2: Stakeholder Grid */}
        {activeTab === 'stakeholder' && (
          <div className="bg-slate-900/80 border border-slate-800 p-6 rounded-2xl shadow-lg space-y-4">
            <h3 className="text-lg font-bold text-white mb-2">Multi-Role Stakeholder Setup</h3>
