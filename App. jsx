              <button onClick={() => { setLanguage('zh'); setIsLangOpen(false); }} className="w-full text-left px-4 py-2.5 text-sm hover:bg-slate-800 text-slate-200">中文 (Chinese)</button>
              <button onClick={() => { setLanguage('ta'); setIsLangOpen(false); }} className="w-full text-left px-4 py-2.5 text-sm hover:bg-slate-800 text-slate-200">தமிழ் (Tamil)</button>
            </div>
          )}
        </div>
      </header>

      <main className="max-w-6xl mx-auto space-y-6">
        {/* Upload Zone */}
