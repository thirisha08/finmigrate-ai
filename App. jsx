            <button
              onClick={handleSendEmail}
              disabled={!parsedData}
              className="bg-cyan-500 hover:bg-cyan-400 disabled:opacity-50 text-slate-950 font-bold px-8 py-3 rounded-xl transition-all shadow-lg flex items-center gap-2 mx-auto"
            >
              <Send className="w-4 h-4" /> {t.sendEmailBtn}
            </button>
            {emailStatus && (
              <div className="bg-slate-950 p-4 rounded-xl border border-slate-800 text-sm text-cyan-200">
