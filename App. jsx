            onClick={() => setIsLangOpen(!isLangOpen)}
            className="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-cyan-300 px-4 py-2 rounded-xl border border-slate-700 text-sm font-medium transition-all"
