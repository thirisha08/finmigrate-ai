                value={selectedRole} 
                onChange={(e) => setSelectedRole(e.target.value)}
                className="w-full bg-slate-900 border border-slate-700 text-slate-100 rounded-lg px-3 py-2 text-sm outline-none"
              >
                <option value="owner">Business Owner ({stakeholders.owner})</option>
