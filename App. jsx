                  type="email" 
                  value={stakeholders.owner} 
                  onChange={(e) => setStakeholders({...stakeholders, owner: e.target.value})}
                  className="w-full bg-slate-900 border border-slate-700 text-slate-100 rounded-lg px-3 py-2 text-sm outline-none"
                />
              </div>
              <div className="bg-slate-950 p-4 rounded-xl border border-slate-800">
                <label className="text-xs font-semibold text-slate-300 block mb-1">Accounts Head Email</label>
                <input 
                  type="email" 
                  value={stakeholders.accountHead} 
                  onChange={(e) => setStakeholders({...stakeholders, accountHead: e.target.value})}
                  className="w-full bg-slate-900 border border-slate-700 text-slate-100 rounded-lg px-3 py-2 text-sm outline-none"
                />
              </div>
            </div>
          </div>
        )}

        {/* Tab 3: Email Notifications with Synced Live Data */}
        {activeTab === 'email' && (
          <div className="bg-slate-900/80 border border-slate-800 p-6 rounded-2xl shadow-lg space-y-6 text-center max-w-xl mx-auto">
