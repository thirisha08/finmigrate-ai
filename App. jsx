            { id: 'stakeholder', label: t.stakeholderTab, icon: Users },
            { id: 'email', label: t.emailTab, icon: Mail },
          ].map((tab) => {
            const Icon = tab.icon;
            return (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm transition-all whitespace-nowrap ${
                  activeTab === tab.id ? 'bg-cyan-500 text-slate-950 font-bold shadow-lg' : 'bg-slate-900 text-slate-300 hover:bg-slate-800'
