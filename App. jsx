          <label className="flex flex-col items-center justify-center border-2 border-dashed border-slate-700 hover:border-cyan-400 rounded-xl p-8 cursor-pointer transition-all bg-slate-950/40">
            <Upload className="w-10 h-10 text-cyan-400 mb-3 animate-bounce" />
            <span className="text-sm font-semibold text-slate-200 text-center">{t.uploadPrompt}</span>
            <input type="file" onChange={handleFileUpload} className="hidden" accept=".pdf,.csv,.xlsx,.xls" />
          </label>
          {file && (
            <div className="mt-4 flex items-center justify-between bg-slate-950 p-3 rounded-lg border border-slate-800 text-sm">
              <span className="flex items-center gap-2 text-slate-300">
                <FileText className="w-4 h-4 text-cyan-400" /> {file.name}
              </span>
              {loading ? (
                <span className="flex items-center gap-2 text-amber-400 text-xs">
