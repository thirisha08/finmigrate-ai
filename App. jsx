    if (uploadedFile) {
      setFile(uploadedFile);
      setLoading(true);

      setTimeout(() => {
        // Dynamic calculated values based on uploaded file
        const rev = 13440579;
        const exp = 9946028;
        const net = rev - exp;
        const margin = ((net / rev) * 100).toFixed(1);
        const score = 59; 
        const status = 'Moderate Risk';

        setParsedData({
          revenue: rev,
          expenses: exp,
          netProfit: net,
          healthScore: score,
          status: status,
          runway: 4.2,
          receivables: 125000,
          aiInsight: `Net profit of ₹${net.toLocaleString('en-IN')} on revenue of ₹${rev.toLocaleString('en-IN')} delivers a ${margin}% margin. Health score is ${score}/100 (${status}). Cash runway is 4.2 months. Monitor outstanding receivables closely.`
        });
        setLoading(false);
      }, 1000);
    }
  };

  const handleSendEmail = () => {
    if (!parsedData) return;
    setEmailStatus(`Sending email via Resend API to ${stakeholders[selectedRole]} (${selectedRole}) with Health Score ${parsedData.healthScore}/100...`);
